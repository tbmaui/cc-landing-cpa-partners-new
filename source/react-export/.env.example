# Environment template
# Copy to .env and fill in the values for your own backend.
# The SUPABASE_* names are read server-side; the VITE_* names are read in the browser.
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
